{
  "info": {
    "name": "Kala - Equipo",
    "description": "Avance 1 - API REST de equipos (/api/equipos). Ejecutar contra el servidor real (mvn spring-boot:run, localhost:8080) con Run collection. El flujo crea su propia empresa para no depender de datos previos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "empresaId", "value": "" },
    { "key": "equipoId", "value": "" }
  ],
  "item": [
    {
      "name": "Setup - crear empresa",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/empresas", "host": ["{{baseUrl}}"], "path": ["api", "empresas"] },
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"ACME\",\n  \"rubro\": \"Tecnologia\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('empresaId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear equipo valido (201 + Location)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/equipos", "host": ["{{baseUrl}}"], "path": ["api", "equipos"] },
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Equipo Ventas\",\n  \"empresaId\": {{empresaId}}\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('devuelve id y empresaId', () => {",
              "  pm.expect(body.id).to.be.a('number');",
              "  pm.expect(body.empresaId).to.eql(Number(pm.collectionVariables.get('empresaId')));",
              "});",
              "pm.test('header Location', () => pm.expect(pm.response.headers.get('Location')).to.eql('/api/equipos/' + body.id));",
              "pm.collectionVariables.set('equipoId', body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar todos los equipos (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/equipos", "host": ["{{baseUrl}}"], "path": ["api", "equipos"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('es un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar equipos filtrando por empresa (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/equipos?empresaId={{empresaId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "equipos"],
          "query": [ { "key": "empresaId", "value": "{{empresaId}}" } ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const esperado = Number(pm.collectionVariables.get('empresaId'));",
              "pm.test('todos pertenecen a la empresa filtrada', () => {",
              "  pm.response.json().forEach(e => pm.expect(e.empresaId).to.eql(esperado));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear equipo con nombre vacio (400)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/equipos", "host": ["{{baseUrl}}"], "path": ["api", "equipos"] },
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"\",\n  \"empresaId\": {{empresaId}}\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [ "pm.test('status 400', () => pm.response.to.have.status(400));" ]
          }
        }
      ]
    },
    {
      "name": "Crear equipo con empresa inexistente (404)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/equipos", "host": ["{{baseUrl}}"], "path": ["api", "equipos"] },
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Equipo huerfano\",\n  \"empresaId\": 999999\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 404', () => pm.response.to.have.status(404));",
              "pm.test('mensaje de empresa inexistente', () => pm.expect(pm.response.json().mensaje).to.include('empresa'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Buscar equipo inexistente (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/equipos/999999", "host": ["{{baseUrl}}"], "path": ["api", "equipos", "999999"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [ "pm.test('status 404', () => pm.response.to.have.status(404));" ]
          }
        }
      ]
    },
    {
      "name": "Actualizar equipo (200)",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/equipos/{{equipoId}}", "host": ["{{baseUrl}}"], "path": ["api", "equipos", "{{equipoId}}"] },
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Equipo Ventas LATAM\",\n  \"empresaId\": {{empresaId}}\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('nombre actualizado', () => pm.expect(pm.response.json().nombre).to.eql('Equipo Ventas LATAM'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Eliminar equipo (204)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/equipos/{{equipoId}}", "host": ["{{baseUrl}}"], "path": ["api", "equipos", "{{equipoId}}"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [ "pm.test('status 204', () => pm.response.to.have.status(204));" ]
          }
        }
      ]
    }
  ]
}
