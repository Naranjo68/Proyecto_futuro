    {
      "name": "ADMIN crea empresa (201 + Location)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/empresas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "empresas"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_admin}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ruc\": \"{{ruc}}\",\n  \"nombre\": \"Empresa Postman {{sufijo}}\",\n  \"rubro\": \"Pruebas\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// RUC de 11 digitos distinto en cada ejecucion",
              "pm.collectionVariables.set('ruc', String(10000000000 + Math.floor(Math.random() * 89999999999)));",
              "pm.collectionVariables.set('sufijo', String(Date.now()));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "const e = pm.response.json();",
              "pm.test('devuelve id y ruc', () => { pm.expect(e.id).to.be.a('number'); pm.expect(e.ruc).to.eql(pm.collectionVariables.get('ruc')); });",
              "pm.test('header Location', () => pm.expect(pm.response.headers.get('Location')).to.eql('/api/empresas/' + e.id));",
              "pm.collectionVariables.set('orgEmpresaId', e.id);"
            ]
          }
        }
      ]
    },
