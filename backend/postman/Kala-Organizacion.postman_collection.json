          "raw": "{\n  \"ruc\": \"{{ruc}}\",\n  \"nombre\": \"Empresa multiequipo {{sufijo}}\",\n  \"rubro\": \"Pruebas\",\n  \"equipos\": [\"Alfa {{sufijo}}\", \"Beta {{sufijo}}\"]\n}"
