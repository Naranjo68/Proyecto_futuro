{
  "info": {
    "name": "Kala - Autenticacion",
    "description": "Avance 2 - Login con JWT, perfil y reporte de administrador. Ejecutar contra el servidor real (localhost:8090) con el entorno 'Kala - Local' seleccionado y adminEmail / adminPassword definidos (los mismos de KALA_ADMIN_EMAIL y KALA_ADMIN_PASSWORD). El orden importa: 'Login valido' guarda {{token_admin}} para el resto. Para probar el vencimiento del token (no automatizado) arranca la aplicacion con app.jwt.ttl-minutes=1, espera dos minutos y repite 'Mi perfil con token'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8090" },
    { "key": "token_admin", "value": "" }
  ],
  "item": [
    {
      "name": "Estado publico (200, sin token)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/publico/estado", "host": ["{{baseUrl}}"], "path": ["api", "publico", "estado"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('API disponible', () => pm.expect(pm.response.json().estado).to.eql('API disponible'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login valido (200 + token)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('tipo Bearer', () => pm.expect(body.tokenType).to.eql('Bearer'));",
              "pm.test('el token tiene 3 partes', () => pm.expect(body.accessToken.split('.')).to.have.length(3));",
              "pm.test('vigencia de 1800 s (30 min)', () => pm.expect(body.expiresInSeconds).to.eql(1800));",
              "pm.test('no devuelve la contrasena', () => pm.expect(pm.response.text()).to.not.include(pm.environment.get('adminPassword')));",
              "pm.environment.set('token_admin', body.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login con contrasena incorrecta (401)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{adminEmail}}\",\n  \"password\": \"contrasena-incorrecta-123\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));",
              "pm.test('no entrega ningun token', () => pm.expect(pm.response.text()).to.not.include('accessToken'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login con usuario inexistente (401)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"nadie@kala.test\",\n  \"password\": \"contrasena-incorrecta-123\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401 (igual que con contrasena incorrecta)', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login sin contrasena (400)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{adminEmail}}\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Mi perfil con token (200)",
      "request": {
        "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token_admin}}", "type": "string" } ] },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const perfil = pm.response.json();",
              "pm.test('el usuario es el del token', () => pm.expect(perfil.username).to.eql(pm.environment.get('adminEmail').trim().toLowerCase()));",
              "pm.test('tiene ROLE_ADMIN', () => pm.expect(perfil.roles).to.include('ROLE_ADMIN'));",
              "pm.test('un administrador no lleva empresa ni equipo', () => { pm.expect(perfil).to.not.have.property('empresaId'); pm.expect(perfil).to.not.have.property('equipoId'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Mi perfil sin token (401)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reporte de administrador con token (200)",
      "request": {
        "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token_admin}}", "type": "string" } ] },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/admin/reporte", "host": ["{{baseUrl}}"], "path": ["api", "admin", "reporte"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('trae la fecha del servidor', () => pm.expect(r.fecha).to.match(/^\\d{4}-\\d{2}-\\d{2}$/));",
              "pm.test('al menos un usuario y un administrador', () => { pm.expect(r.totalUsuarios).to.be.at.least(1); pm.expect(r.administradores).to.be.at.least(1); });",
              "pm.test('solo conteos, sin datos de personas', () => pm.expect(Object.keys(r).sort()).to.eql(['administradores','empleados','fecha','personalEmpresa','totalUsuarios']));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reporte de administrador sin token (401)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/admin/reporte", "host": ["{{baseUrl}}"], "path": ["api", "admin", "reporte"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reporte con el token alterado (401)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token_admin}}x" } ],
        "url": { "raw": "{{baseUrl}}/api/admin/reporte", "host": ["{{baseUrl}}"], "path": ["api", "admin", "reporte"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('un token modificado se rechaza con 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Recurso del avance 1 sin token (401)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/empresas", "host": ["{{baseUrl}}"], "path": ["api", "empresas"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Recurso del avance 1 con token (200)",
      "request": {
        "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token_admin}}", "type": "string" } ] },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/empresas", "host": ["{{baseUrl}}"], "path": ["api", "empresas"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "HTTP Basic ya no se acepta (401)",
      "request": {
        "auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{adminEmail}}", "type": "string" }, { "key": "password", "value": "{{adminPassword}}", "type": "string" } ] },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/empresas", "host": ["{{baseUrl}}"], "path": ["api", "empresas"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Basic se rechaza: ahora solo vale el Bearer token', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
