    {
      "name": "ADMIN activa el pulso (200 + gasto de privacidad)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/empresas/{{empresaId}}/cuestionarios/{{cuestionarioId}}/activar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "empresas",
            "{{empresaId}}",
            "cuestionarios",
            "{{cuestionarioId}}",
            "activar"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_admin}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('el pulso semanal con p=0.75 gasta ~5.49 al mes por persona', () => pm.expect(r.epsilonMensual).to.be.within(5.48, 5.50));",
              "pm.test('el gasto no excede el maximo', () => pm.expect(r.epsilonMensual).to.be.at.most(r.epsilonMaximo));",
              "pm.collectionVariables.set('epsilonMensual', r.epsilonMensual);"
            ]
          }
        }
      ]
    },
    {
      "name": "Activar de nuevo es idempotente (200, mismo gasto)",
