    {
      "name": "EMPLEADO recibe lo necesario para aleatorizar (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/cuestionarios/pendientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cuestionarios",
            "pendientes"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_empleado}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const lista = pm.response.json();",
              "pm.test('trae el pulso', () => pm.expect(lista.map(c => c.codigo)).to.include('PULSO'));",
              "const pulso = lista.find(c => c.codigo === 'PULSO'); const item = pulso.items[0];",
              "pm.test('el item trae mecanismo y p', () => { pm.expect(item.mecanismo).to.eql('RANDOMIZED_RESPONSE'); pm.expect(item.probabilidadVerdad).to.eql(0.75); });",
              "pm.test('la escala es binaria con dos opciones', () => { pm.expect(item.escala.opciones).to.have.length(2); });",
              "pm.test('no se expone ninguna entidad interna', () => pm.expect(pm.response.text()).to.not.match(/empresa_id|password/i));",
              "pm.environment.set('itemId', item.itemId); pm.environment.set('configuracionLdpId', item.configuracionLdpId); pm.environment.set('probabilidadVerdad', item.probabilidadVerdad);"
            ]
          }
        }
      ]
