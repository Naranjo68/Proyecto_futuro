{
  "info": {
    "name": "Kala - Cuestionarios",
    "description": "Avance 2 - Activacion con presupuesto de privacidad, listado por empresa y cuestionarios pendientes del empleado. Requiere Kala - 00 Tokens. cuestionarioId es el id del cuestionario PULSO del seed (en el SQL Editor: SELECT id FROM cuestionario WHERE codigo = 'PULSO').",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090"
    }
  ],
  "item": [
    {
      "name": "Activar sin token (401)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/empresas/{{empresaId}}/cuestionarios/{{cuestionarioId}}/activar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "empresas",
            "{{empresaId}}",
            "cuestionarios",
            "{{cuestionarioId}}",
            "activar"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
