    {
      "name": "RRHH consulta la semana (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/dashboard/{{equipoId}}?semana={{semana}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboard",
            "{{equipoId}}"
          ],
          "query": [
