{
  "info": {
    "name": "Kala - CheckIn y Dashboard",
    "description": "Avance 2 - El empleado aleatoriza su respuesta y la envia; RRHH consulta la estimacion semanal. Requiere Kala - 00 Tokens y Kala - Cuestionarios (que guarda itemId y configuracionLdpId). Con menos de 30 respuestas el dashboard devuelve DATOS_INSUFICIENTES; para ver OK use el script de la demostracion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090"
    },
    {
      "key": "semana",
      "value": ""
    },
    {
      "key": "semanaNoLunes",
      "value": ""
    },
    {
      "key": "respuestaRuidosa",
      "value": "true"
    }
  ],
  "item": [
    {
      "name": "Check-in sin token (401)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/checkin",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "checkin"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"itemId\": {{itemId}},\n  \"configuracionLdpId\": {{configuracionLdpId}},\n  \"respuestaRuidosa\": {{respuestaRuidosa}}\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Lunes de la semana actual en America/Lima (la ventana del dashboard) y un dia que no es lunes.",
              "const d = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/Lima' }));",
              "d.setDate(d.getDate() - ((d.getDay() + 6) % 7));",
              "const iso = x => x.getFullYear() + '-' + String(x.getMonth() + 1).padStart(2, '0') + '-' + String(x.getDate()).padStart(2, '0');",
              "pm.collectionVariables.set('semana', iso(d));",
              "d.setDate(d.getDate() + 1);",
              "pm.collectionVariables.set('semanaNoLunes', iso(d));",
              "// El dispositivo aleatoriza ANTES de enviar: dice la verdad con probabilidad p y lo contrario con 1-p.",
              "const p = Number(pm.environment.get('probabilidadVerdad') || 0.75);",
              "const real = Math.random() < 0.3;",
              "pm.collectionVariables.set('respuestaRuidosa', String(Math.random() < p ? real : !real));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
