              "key": "semana",
              "value": "{{semana}}"
            }
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_rrhh}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('el resultado es OK o DATOS_INSUFICIENTES', () => pm.expect(['OK', 'DATOS_INSUFICIENTES']).to.include(r.resultado));",
              "pm.test('hay al menos la respuesta del empleado', () => pm.expect(r.totalRespuestas).to.be.at.least(1));",
              "pm.test('con datos insuficientes NO hay proporcion; con OK si, entre 0 y 1', () => { const i = r.items[0]; if (r.resultado === 'DATOS_INSUFICIENTES') { pm.expect(i.proporcionEstimada).to.be.null; pm.expect(i.margenError95).to.be.null; } else { pm.expect(i.proporcionEstimada).to.be.within(0, 1); pm.expect(i.margenError95).to.be.above(0); } });",
              "pm.test('no expone a las personas', () => pm.expect(pm.response.text()).to.not.include(pm.environment.get('empleadoEmail')));"
            ]
          }
        }
      ]
    },
